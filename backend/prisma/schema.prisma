generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                   String             @id @default(uuid())
  email                String             @unique
  passwordHash         String
  name                 String
  role                 Role               @default(ARTIST)
  isActive             Boolean            @default(true)
  trialEndsAt          DateTime?
  stripeCustomerId     String?            @unique
  stripeSubscriptionId String?            @unique
  subscriptionStatus   SubscriptionStatus @default(TRIAL)
  currentPeriodEnd     DateTime?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  clients           Client[]
  appointments      Appointment[]
  bookingRequests   BookingRequest[]
  pushSubscriptions PushSubscription[]
}

enum Role {
  ARTIST
  ADMIN
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  CANCELLED
  EXPIRED
}

model Client {
  id            String   @id @default(uuid())
  artistId      String
  artist        User     @relation(fields: [artistId], references: [id])
  firstName     String
  lastName      String
  email         String?
  phone         String?
  tattooHistory String?  @db.Text
  customFields  Json?
  portalToken   String?  @unique @default(uuid())
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  appointments Appointment[]
  consentForms ConsentForm[]
  images       ClientImage[]
  gallery      ClientGallery[]
}

model ClientImage {
  id        String    @id @default(uuid())
  clientId  String
  client    Client    @relation(fields: [clientId], references: [id])
  imageUrl  String
  type      ImageType
  createdAt DateTime  @default(now())
}

enum ImageType {
  REFERENCE
  PREVIOUS_WORK
}

model Appointment {
  id              String     @id @default(uuid())
  clientId        String
  client          Client     @relation(fields: [clientId], references: [id])
  artistId        String
  artist          User       @relation(fields: [artistId], references: [id])
  title           String
  description     String?
  startTime       DateTime
  endTime         DateTime
  status          ApptStatus @default(SCHEDULED)
  price           Decimal?
  depositAmount   Decimal?
  depositPaid     Boolean    @default(false)
  deposit         Float      @default(0)
  stripePaymentId String?
  googleEventId   String?
  isActive        Boolean    @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum ApptStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
  NO_SHOW
}

model BookingRequest {
  id             String   @id @default(uuid())
  artistId       String?
  artist         User?    @relation(fields: [artistId], references: [id])
  name           String
  email          String
  phone          String
  tattooIdea     String
  referenceLink  String?
  preferredMonth String
  status         String   @default("PENDING")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model ConsentForm {
  id                String   @id @default(uuid())
  clientId          String
  client            Client   @relation(fields: [clientId], references: [id])
  medicalConditions String?  @db.Text
  allergies         String?  @db.Text
  agreedToTerms     Boolean  @default(true)
  signatureName     String
  signatureImage    String?  @db.Text
  createdAt         DateTime @default(now())
}

model PushSubscription {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  @@index([userId])
}

model ClientGallery {
  id                 String   @id @default(uuid())
  clientId           String
  client             Client   @relation(fields: [clientId], references: [id])
  imageUrl           String
  description        String?
  cloudinaryPublicId String?
  createdAt          DateTime @default(now())
}
